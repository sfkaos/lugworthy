   "id": "BRD-1282/lil-dipper-1",
   "name": "The Lil' Dipper",
   "url": "https://www.schondsgn.com/products/lil-dipper-1",
   "image": {
    "url": "https://cdn.shopify.com/s/files/1/0281/7862/files/IMG_0004_2.jpg?v=1788395972",
